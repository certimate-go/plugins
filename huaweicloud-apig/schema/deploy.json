{
  "schemaVersion": "form/v1",
  "provider": "huaweicloud-apig",
  "category": "deploy",
  "schema": {
    "columns": [
      {
        "name": "region",
        "valueType": "text",
        "labelKey": "plugin.huaweicloud-apig.region.label",
        "placeholderKey": "plugin.huaweicloud-apig.region.placeholder",
        "tooltipKey": "plugin.huaweicloud-apig.region.tooltip",
        "tooltipHtml": true,
        "default": "",
        "required": true
      },
      {
