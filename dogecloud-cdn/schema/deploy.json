{
  "schemaVersion": "form/v1",
  "provider": "dogecloud-cdn",
  "category": "deploy",
  "schema": {
    "columns": [
      {
        "name": "domainMatchPattern",
        "valueType": "radio",
        "labelKey": "plugin.dogecloud-cdn.deploy.domain_match_pattern.label",
        "default": "exact",
        "required": true,
        "options": [
          { "value": "exact", "labelKey": "plugin.dogecloud-cdn.deploy.domain_match_pattern.option.exact.label" },
          { "value": "certsan", "labelKey": "plugin.dogecloud-cdn.deploy.domain_match_pattern.option.certsan.label" }
        ]
      },
      {
        "name": "domain",
        "valueType": "text",
        "labelKey": "plugin.dogecloud-cdn.deploy.domain.label",
        "placeholderKey": "plugin.dogecloud-cdn.deploy.domain.placeholder",
        "dependencies": ["domainMatchPattern"],
        "visibleWhen": [{ "field": "domainMatchPattern", "op": "notIn", "values": ["certsan"] }],
        "requiredWhen": [{ "field": "domainMatchPattern", "op": "in", "values": ["exact"] }],
        "validateWhen": [
          { "field": "domainMatchPattern", "op": "in", "values": ["exact"], "validator": "domain" }
        ]
      }
    ]
  }
}
