{
  "schemaVersion": "form/v1",
  "provider": "huaweicloud-vod",
  "category": "deploy",
  "schema": {
    "columns": [
      {
        "name": "region",
        "valueType": "text",
        "labelKey": "plugin.huaweicloud-vod.region.label",
        "placeholderKey": "plugin.huaweicloud-vod.region.placeholder",
        "tooltipKey": "plugin.huaweicloud-vod.region.tooltip",
        "tooltipHtml": true,
        "default": "",
        "required": true
      },
      {
        "name": "domainMatchPattern",
        "valueType": "radio",
        "labelKey": "plugin.huaweicloud-vod.domainMatchPattern.label",
        "default": "exact",
        "required": true,
        "defaultOnMissing": true,
        "options": [
          {
            "value": "exact",
            "labelKey": "plugin.huaweicloud-vod.domainMatchPattern.exact"
          }
        ],
        "allowCustomValue": true
      },
      {
        "name": "domain",
        "valueType": "text",
        "labelKey": "plugin.huaweicloud-vod.domain.label",
        "placeholderKey": "plugin.huaweicloud-vod.domain.placeholder",
        "default": "",
        "requiredWhen": [
          {
            "field": "domainMatchPattern",
            "op": "eq",
            "values": [
              "exact"
            ]
          }
        ],
        "validateWhen": [
          {
            "field": "domainMatchPattern",
            "op": "eq",
            "values": [
              "exact"
            ],
            "validator": "domain",
            "params": {
              "allowWildcard": false
            }
          }
        ]
      }
    ]
  }
}
