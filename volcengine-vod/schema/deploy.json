{
  "schemaVersion": "form/v1",
  "provider": "volcengine-vod",
  "category": "deploy",
  "schema": {
    "columns": [
      {
        "name": "region",
        "valueType": "text",
        "labelKey": "plugin.volcengine-vod.region.label",
        "placeholderKey": "plugin.volcengine-vod.region.placeholder",
        "tooltipKey": "plugin.volcengine-vod.region.tooltip",
        "tooltipHtml": true,
        "default": "cn-north-1",
        "required": true
      },
      {
        "name": "spaceName",
        "valueType": "text",
        "labelKey": "plugin.volcengine-vod.spaceName.label",
        "placeholderKey": "plugin.volcengine-vod.spaceName.placeholder",
        "tooltipKey": "plugin.volcengine-vod.spaceName.tooltip",
        "tooltipHtml": true,
        "default": "",
        "required": true
      },
      {
        "name": "domainType",
        "valueType": "select",
        "labelKey": "plugin.volcengine-vod.domainType.label",
        "placeholderKey": "plugin.volcengine-vod.domainType.placeholder",
        "default": "play",
        "required": true,
        "options": [
          {
            "value": "play",
            "labelKey": "plugin.volcengine-vod.domainType.play"
          },
          {
            "value": "image",
            "labelKey": "plugin.volcengine-vod.domainType.image"
          },
          {
            "value": "third",
            "labelKey": "plugin.volcengine-vod.domainType.third"
          }
        ]
      },
      {
        "name": "domainMatchPattern",
        "valueType": "radio",
        "labelKey": "plugin.volcengine-vod.domainMatchPattern.label",
        "default": "exact",
        "required": true,
        "defaultOnMissing": true,
        "options": [
          {
            "value": "exact",
            "labelKey": "plugin.volcengine-vod.domainMatchPattern.exact"
          },
          {
            "value": "wildcard",
            "labelKey": "plugin.volcengine-vod.domainMatchPattern.wildcard"
          },
          {
            "value": "certsan",
            "labelKey": "plugin.volcengine-vod.domainMatchPattern.certsan"
          }
        ],
        "allowCustomValue": true
      },
      {
        "name": "domain",
        "valueType": "text",
        "labelKey": "plugin.volcengine-vod.domain.label",
        "placeholderKey": "plugin.volcengine-vod.domain.placeholder",
        "default": "",
        "visibleWhen": [
          {
            "field": "domainMatchPattern",
            "op": "ne",
            "values": [
              "certsan"
            ]
          }
        ],
        "requiredWhen": [
          {
            "field": "domainMatchPattern",
            "op": "in",
            "values": [
              "exact",
              "wildcard"
            ]
          }
        ],
        "validateWhen": [
          {
            "field": "domainMatchPattern",
            "op": "in",
            "values": [
              "exact",
              "wildcard"
            ],
            "validator": "domain",
            "params": {
              "allowWildcard": true
            }
          }
        ]
      }
    ]
  }
}
