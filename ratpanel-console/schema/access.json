{
  "schemaVersion": "form/v1",
  "provider": "ratpanel",
  "category": "access",
  "schema": {
    "columns": [
      {
        "name": "serverUrl",
        "valueType": "text",
        "labelKey": "access.form.ratpanel_server_url.label",
        "placeholderKey": "access.form.ratpanel_server_url.placeholder",
        "extraKey": "access.form.ratpanel_server_url.help",
        "required": true,
        "default": "http://<your-host-addr>:8888/",
        "validateWhen": [
          {
            "field": "serverUrl",
            "op": "ne",
            "values": [
              ""
            ],
            "validator": "url"
          }
        ],
        "inputType": "url"
      },
      {
        "name": "accessTokenId",
        "valueType": "text",
        "labelKey": "access.form.ratpanel_access_token_id.label",
        "placeholderKey": "access.form.ratpanel_access_token_id.placeholder",
        "tooltipKey": "access.form.ratpanel_access_token_id.tooltip",
        "tooltipHtml": true,
        "required": true,
        "default": 1,
        "validateWhen": [
          {
            "field": "accessTokenId",
            "op": "ne",
            "values": [
              ""
            ],
            "validator": "positiveInteger"
          }
        ],
        "inputType": "number",
        "numericValue": "positiveInteger"
      },
      {
        "name": "accessToken",
        "valueType": "secret",
        "labelKey": "access.form.ratpanel_access_token.label",
        "placeholderKey": "access.form.ratpanel_access_token.placeholder",
        "tooltipKey": "access.form.ratpanel_access_token.tooltip",
        "tooltipHtml": true,
        "required": true,
        "default": "",
        "secret": true
      },
      {
        "name": "allowInsecureConnections",
        "valueType": "switch",
        "labelKey": "access.form.shared_allow_insecure_conns.label"
      }
    ]
  }
}
