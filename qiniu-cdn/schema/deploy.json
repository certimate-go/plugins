{
  "schemaVersion": "form/v1",
  "provider": "qiniu-cdn",
  "category": "deploy",
  "schema": {
    "columns": [
      {
        "name": "domainMatchPattern",
        "valueType": "radio",
        "labelKey": "plugin.qiniu-cdn.deploy.domain_match_pattern.label",
        "default": "exact",
        "required": true,
        "options": [
          { "value": "exact", "labelKey": "plugin.qiniu-cdn.deploy.domain_match_pattern.option.exact.label" },
          { "value": "wildcard", "labelKey": "plugin.qiniu-cdn.deploy.domain_match_pattern.option.wildcard.label" },
          { "value": "certsan", "labelKey": "plugin.qiniu-cdn.deploy.domain_match_pattern.option.certsan.label" }
        ],
        "extraKey": "plugin.qiniu-cdn.deploy.domain_match_pattern.option.exact.help",
        "extraHtml": true
      },
      {
        "name": "domain",
        "valueType": "text",
        "labelKey": "plugin.qiniu-cdn.deploy.domain.label",
        "placeholderKey": "plugin.qiniu-cdn.deploy.domain.placeholder",
        "dependencies": ["domainMatchPattern"],
        "visibleWhen": [{ "field": "domainMatchPattern", "op": "notIn", "values": ["certsan"] }],
        "requiredWhen": [{ "field": "domainMatchPattern", "op": "in", "values": ["exact", "wildcard"] }],
        "validateWhen": [
          { "field": "domainMatchPattern", "op": "in", "values": ["exact", "wildcard"], "validator": "domain", "params": { "allowWildcard": true } }
        ]
      }
    ]
  }
}
