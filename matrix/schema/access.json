{
  "schemaVersion": "form/v1",
  "provider": "matrix",
  "category": "access",
  "schema": {
    "columns": [
      {
        "name": "serverUrl",
        "valueType": "text",
        "labelKey": "plugin.matrix.access.serverUrl.label",
        "placeholderKey": "plugin.matrix.access.serverUrl.placeholder",
        "default": "https://matrix-client.matrix.org",
        "required": true,
        "validateWhen": [
          {
            "field": "serverUrl",
            "op": "ne",
            "values": [
              ""
            ],
            "validator": "url"
          }
        ]
      },
      {
        "name": "userId",
        "valueType": "text",
        "labelKey": "plugin.matrix.access.userId.label",
        "tooltipKey": "plugin.matrix.access.userId.tooltip",
        "tooltipHtml": true,
        "placeholderKey": "plugin.matrix.access.userId.placeholder",
        "required": true,
        "validateWhen": [
          {
            "field": "userId",
            "op": "ne",
            "values": [
              ""
            ],
            "validator": "regex",
            "params": {
              "pattern": "^@"
            }
          }
        ]
      },
      {
        "name": "accessToken",
        "valueType": "secret",
        "labelKey": "plugin.matrix.access.accessToken.label",
        "tooltipKey": "plugin.matrix.access.accessToken.tooltip",
        "tooltipHtml": true,
        "placeholderKey": "plugin.matrix.access.accessToken.placeholder",
        "required": true,
        "secret": true
      },
      {
        "name": "roomId",
        "valueType": "text",
        "allowClear": true,
        "labelKey": "plugin.matrix.access.roomId.label",
        "tooltipKey": "plugin.matrix.access.roomId.tooltip",
        "tooltipHtml": true,
        "placeholderKey": "plugin.matrix.access.roomId.placeholder",
        "extraKey": "plugin.matrix.access.roomId.help"
      }
    ]
  }
}
